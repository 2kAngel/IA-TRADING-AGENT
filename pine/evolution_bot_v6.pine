//@version=6
strategy("Bitcoin Evolution - Bot Canónico v6", 
         overlay=true, 
         initial_capital=20, 
         currency=currency.EUR, 
         default_qty_type=strategy.percent_of_equity, 
         default_qty_value=100,
         commission_type=strategy.commission.percent,
         commission_value=0.075,
         slippage=2)

// ==========================================
// 1. GENOMA CONFIGURABLE DEL BOT (HERENCIA)
// ==========================================
botId           = input.string("GENESIS-BOT-0", "ID del Bot", group="Identidad Evolutiva")
generation      = input.int(0, "Generacion", group="Identidad Evolutiva")
donchianEntry   = input.int(15, "Periodo Donchian Entrada", minval=5, group="Genoma Tecnico")
donchianExit    = input.int(8, "Periodo Donchian Salida", minval=3, group="Genoma Tecnico")
slPct           = input.float(1.5, "Stop Loss (%)", minval=0.5, step=0.1, group="Gestion de Riesgo") / 100.0

// ==========================================
// 2. INDICADORES TECNICOS
// ==========================================
canalAlto = ta.highest(high[1], donchianEntry)
canalBajo = ta.lowest(low[1], donchianExit)

// ==========================================
// 3. SENALES LONG / FLAT (SPOT SIN APALANCAMIENTO)
// ==========================================
condicionLong = ta.crossover(close, canalAlto) and (strategy.position_size == 0)

var float stopLossPrice = na

// Esquema JSON para alertas de comunicacion con el motor Python
msgBuy  = '{"bot_id": "' + botId + '", "action": "BUY", "symbol": "' + syminfo.ticker + '", "price": ' + str.tostring(close) + ', "gen": ' + str.tostring(generation) + '}'
msgSell = '{"bot_id": "' + botId + '", "action": "CLOSE", "symbol": "' + syminfo.ticker + '", "price": ' + str.tostring(close) + ', "gen": ' + str.tostring(generation) + '}'

if condicionLong
    stopLossPrice := close * (1.0 - slPct)
    strategy.entry("Long", strategy.long, alert_message=msgBuy)

if strategy.position_size > 0
    // Salida por ruptura de canal bajo o toque de Stop Loss
    precioSalida = math.max(canalBajo, nz(stopLossPrice))
    strategy.exit("Cierre Long", from_entry="Long", stop=precioSalida, alert_message=msgSell)
else
    stopLossPrice := na

// ==========================================
// 4. PLOTS VISUALES
// ==========================================
plot(canalAlto, title="Canal Entrada (Max)", color=color.blue, linewidth=2)
plot(canalBajo, title="Canal Salida (Min)", color=color.orange, linewidth=1)
plot(stopLossPrice, title="Stop Loss Ceñido", color=color.red, style=plot.style_linebr, linewidth=2)
